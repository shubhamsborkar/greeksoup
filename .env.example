# The desk's settings file. You do not have to edit it: the Settings screen
# inside the desk (http://localhost:8765/settings) writes every line below for
# you, and a new version of the desk never touches this file.

# ---- Broker (Desk · Home reads one account, read-only) ---------------------
# Which broker file under brokers/ to read through. One of:
#   alpaca  icici_breeze  ibkr_flex  tradier  trading212  zerodha_kite
# Empty = no broker; Desk · Book keeps a portfolio by hand instead.
BROKER=

# Alpaca (United States): key ID and secret from the dashboard; PAPER=on for a
# paper account.
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_PAPER=off

# ICICI Direct, Breeze API (India): app key and secret from api.icicidirect.com.
# The daily login token is NOT stored here; the Settings screen takes it each
# morning and keeps it for the day (session_token_primary.txt).
BREEZE_API_KEY=
BREEZE_API_SECRET=

# Interactive Brokers, Flex Web Service (worldwide): the token and the id of a
# Flex Query with the Open Positions section, both from Client Portal.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY=

# Tradier (United States): one access token; ACCOUNT empty = the first account.
TRADIER_TOKEN=
TRADIER_ACCOUNT=
TRADIER_SANDBOX=off

# Trading 212 (United Kingdom, Europe): key and secret generated in the app.
T212_KEY=
T212_SECRET=
T212_DEMO=off

# Zerodha, Kite Connect (India): app key and secret from developers.kite.trade.
# Daily login, like ICICI Direct: the Settings screen takes it each morning.
KITE_API_KEY=
KITE_API_SECRET=

# ---- Data provider (optional; without one the desk runs on the free record) --
# fmp = Financial Modeling Prep, the provider whose reads ship in the desk.
# Any other name = a provider file your agent writes (data_providers/CONTRACT.md),
# which reads DATA_API_KEY and DATA_BASE_URL.
DATA_PROVIDER=
FMP_API_KEY=
DATA_API_KEY=
DATA_BASE_URL=

# ---- Your AI (optional) -------------------------------------------------------
# PROVIDER is a preset (anthropic, openai, google, deepseek, kimi, minimax, zai,
# qwen, xai, mistral, openrouter, ollama, lmstudio, custom). FORMAT is the
# request shape the endpoint speaks: openai (.../chat/completions) or anthropic
# (.../v1/messages). The preset fills FORMAT, BASE_URL and a starting MODEL.
AI_PROVIDER=
AI_FORMAT=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ---- The desk itself ---------------------------------------------------------
# SEC EDGAR asks for a contact address in the User-Agent of every request.
EDGAR_CONTACT=

# Where the dated markdown reports go. Empty = ./output inside this folder.
VAULT_OUTPUT_DIR=

# Port for the desk (default 8765).
DESK_PORT=8765

# on = bring a newer version in the day it appears, without the click.
DESK_AUTO_UPDATE=off
