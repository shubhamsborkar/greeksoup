# The desk's settings file. You do not have to edit it: the Settings screen
# inside the desk (http://localhost:8765/settings) writes every line below for
# you, and a new version of the desk never touches this file.

# ---- Brokers (Desk · Home reads each account, read-only) -------------------
# The broker files under brokers/ to read through, one per market, the home one
# first, separated by commas; each is its own desk on Desk · Home (the home
# market's, the US, the rest of the world), never added together. One of:
#   alpaca  angel_one  schwab  dhan  groww  icici_breeze  ibkr_flex  longbridge
#   questrade  saxo  tastytrade  tradier  trading212  upstox  zerodha_kite
# Empty = no broker; Desk · Book keeps a portfolio by hand instead.
BROKERS=
BROKER=

# The home market normally follows the broker. With no broker, name one here
# (in, us, or a market file your agent wrote) so the home screens take its
# shape; empty = global, Watch · Home takes Yahoo symbols.
HOME_MARKET=

# Alpaca (United States): key ID and secret from the dashboard; PAPER=on for a
# paper account.
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_PAPER=off

# Angel One, SmartAPI (India): app key from smartapi.angelone.in, then the
# client code, the trading PIN and the secret behind the authenticator QR code.
# The desk works the six digits out itself, so there is no daily paste.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Charles Schwab (United States): app key and secret from developer.schwab.com,
# on an app carrying the Accounts and Trading product. The callback has to start
# with https; empty = https://127.0.0.1. Weekly login: the Settings screen takes
# it and keeps it for seven days (session_token_schwab.txt).
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK=

# Dhan (India): client id, and either a token from My Profile on web.dhan.co
# (it lasts 24 hours) or the PIN and authenticator secret for an automatic one.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_PIN=
DHAN_TOTP_SECRET=

# Groww (India): key and secret from the Groww Cloud API keys page (the trading
# API is a paid subscription, and the key is approved there each day). A token
# pasted from the same page works in the key box on its own.
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_SECRET=

# ICICI Direct, Breeze API (India): app key and secret from api.icicidirect.com.
# Daily login: the Settings screen takes it each morning and keeps it for the
# day (session_token_primary.txt); the token is never stored here.
BREEZE_API_KEY=
BREEZE_API_SECRET=

# Interactive Brokers, Flex Web Service (worldwide): the token and the id of a
# Flex Query with the Open Positions section, both from Client Portal.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY=

# Longbridge (Hong Kong, Singapore): app key, app secret and the access token
# from its developer page; Longbridge issues the token for ninety days. HOST
# empty = openapi.longbridge.com.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_HOST=

# Questrade (Canada): the manual token from the App Hub. It is spent on first
# use and the desk keeps the replacement Questrade sends back
# (session_token_questrade.txt); a new manual one is needed after three days off.
QUESTRADE_REFRESH_TOKEN=
QUESTRADE_ACCOUNT=

# Saxo Bank (Europe, Asia, the Middle East): app key and secret from
# developer.saxo; REDIRECT empty = this desk's Settings address, SIM=on for the
# practice system. Daily login: Saxo's key is short lived and is replaced on
# every use, so the desk saves the new one while it runs.
SAXO_APP_KEY=
SAXO_APP_SECRET=
SAXO_REDIRECT_URI=
SAXO_SIM=off

# tastytrade (United States): the client secret and refresh token from a grant
# made under OAuth Applications on tastytrade's site. Neither expires.
TASTY_CLIENT_SECRET=
TASTY_REFRESH_TOKEN=
TASTY_ACCOUNT=
TASTY_SANDBOX=off

# Tradier (United States): one access token; ACCOUNT empty = the first account.
TRADIER_TOKEN=
TRADIER_ACCOUNT=
TRADIER_SANDBOX=off

# Trading 212 (United Kingdom, Europe): key and secret generated in the app.
T212_KEY=
T212_SECRET=
T212_DEMO=off

# Upstox (India): API key and secret from the developer console; the redirect
# address must match the one registered on the app, empty = this desk's Settings
# address. Daily login: every Upstox token dies at 3:30 AM.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=

# Zerodha, Kite Connect (India): app key and secret from developers.kite.trade.
# Daily login: the Settings screen takes it each morning.
KITE_API_KEY=
KITE_API_SECRET=

# ---- Data provider (optional; without one the desk runs on the free record) --
# fmp = Financial Modeling Prep, the provider whose reads ship in the desk.
# Any other name = a provider file your agent writes (data_providers/CONTRACT.md),
# which reads DATA_API_KEY and DATA_BASE_URL.
DATA_PROVIDER=
FMP_API_KEY=
DATA_API_KEY=
DATA_BASE_URL=

# ---- Your AI (optional) -------------------------------------------------------
# PROVIDER is a preset (anthropic, openai, google, deepseek, kimi, minimax, zai,
# qwen, xai, mistral, openrouter, ollama, lmstudio, custom). FORMAT is the
# request shape the endpoint speaks: openai (.../chat/completions) or anthropic
# (.../v1/messages). The preset fills FORMAT, BASE_URL and a starting MODEL.
AI_PROVIDER=
AI_FORMAT=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ---- The desk itself ---------------------------------------------------------
# SEC EDGAR asks for a contact address in the User-Agent of every request.
EDGAR_CONTACT=

# Where the dated markdown reports go. Empty = ./output inside this folder.
VAULT_OUTPUT_DIR=

# Port for the desk (default 8765).
DESK_PORT=8765

# on = bring a newer version in the day it appears, without the click.
DESK_AUTO_UPDATE=off
